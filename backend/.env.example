# Server
PORT=5000
NODE_ENV=development

# MongoDB (application metadata only — never authoritative for wallet/token state)
MONGO_URI=mongodb://127.0.0.1:27017/sectorial_wallet

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h

# Blockchain (local Hardhat node by default)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337

# Fill these in after running `npx hardhat run scripts/deploy.js --network localhost`
# in the blockchain/ package (see deployments/localhost.json for the values).
MULTISIG_CONTRACT_ADDRESS=
TOKEN_CONTRACT_ADDRESS=

# Frontend origin allowed to call this API
CORS_ORIGIN=http://localhost:5173
